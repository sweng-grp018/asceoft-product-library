# Copy this file to .env.local for local development.
# .env.local is git-ignored. Never put real production credentials here.

DATABASE_URL=postgresql://lensistry:lensistry@127.0.0.1:5433/lensistry
# Port 5433 matches docker-compose.yml. If you set DB_PORT there, change the port here too.

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. Use a different value per environment.
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Must be kept in sync with the URL the app is served from.
BETTER_AUTH_URL=http://localhost:3000
