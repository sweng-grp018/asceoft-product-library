# Local development template. Copy to `.env` at the repository root.
# `.env` is git-ignored. These are local-only development fixtures
# (database and MinIO defaults); never reuse them in a shared or hosted environment.
# Generate independent, random 32+ character values for AUTH_SECRET and JWT_SECRET.

DATABASE_URL="postgresql://lensistry:lensistry@localhost:5433/lensistry?schema=public"
API_PORT=4000
API_URL="http://localhost:4000"
WEB_ORIGIN="http://localhost:3000"
AUTH_SECRET="replace-with-a-random-32-plus-character-string"
JWT_SECRET="replace-with-an-independent-32-plus-character-string"
JWT_ISSUER="lensistry-api"
JWT_AUDIENCE="lensistry-cms"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="lensistry"
# Local filesystem-backed S3 service: bun run dev:storage.
# Replace all S3 settings with your hosted bucket settings when deploying.
# The optional Docker MinIO setup instead uses its configured MinIO keys.
S3_ACCESS_KEY_ID="S3RVER"
S3_SECRET_ACCESS_KEY="S3RVER"

# Optional legacy server inference for local development only.
# Web startup and deployment do not require Python or an AI endpoint.
# Browser inference will load an exported model directly on the user's device.
# AI_SERVICE_URL="http://localhost:8000"

# Set these only when running the one-time admin creation command.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="a-long-random-password"
# ADMIN_NAME="Store Manager"
