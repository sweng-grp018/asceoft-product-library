# Copy this file to .env.local for local development.
# .env.local is git-ignored. Fill in every value below.
# Never put real credentials in this committed template.

# Database connection string. See "Local Setup" in README.md for the local values.
DATABASE_URL=

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. Use a different value per environment.
BETTER_AUTH_SECRET=

# Must be kept in sync with the URL the app is served from.
BETTER_AUTH_URL=http://localhost:3000
