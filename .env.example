# Copy to .env; change all development-only secrets before sharing access.
DATABASE_URL="postgresql://lensistry:lensistry@localhost:5432/lensistry?schema=public"
API_PORT=4000
API_URL="http://localhost:4000"
WEB_ORIGIN="http://localhost:3000"
AUTH_SECRET="replace-with-a-random-32-plus-character-string"
JWT_SECRET="replace-with-an-independent-32-plus-character-string"
JWT_ISSUER="lensistry-api"
JWT_AUDIENCE="lensistry-cms"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="lensistry"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
AI_SERVICE_URL="http://localhost:8000"

# Set these only when running the one-time admin creation command.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="a-long-random-password"
# ADMIN_NAME="Administrator"
