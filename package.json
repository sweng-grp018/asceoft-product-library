{
  "name": "asceoft-product-library",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "api"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:api": "bun run --cwd api dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsrs --noEmit",
    "typecheck:api": "bun run --cwd api typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:api": "bun run --cwd api test",
    "db:generate": "bun run --cwd api db:generate",
    "db:migrate": "bun run --cwd api db:migrate",
    "db:studio": "bun run --cwd api db:studio",
    "db:seed-admin": "bun run --cwd api seed:admin"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "tsrs": "^0.20.1-ts7.1.0-beta",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
